NEXT_PUBLIC_APP_ENV=local
APP_DEPLOYMENT=shared
APP_BASE_DOMAIN=dwello.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_VERSION=0.1.0-local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key

# CI and migration tooling only. Never read by the running application.
SUPABASE_DB_URL=replace-with-ci-database-url

# Configure these in the host secret store for staging and production.
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=dwello@example.test
EMAIL_FROM_NAME=Dwello
DEVELOPER_ALERT_EMAIL=developer@example.test
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-local-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-local-vapid-private-key
VAPID_SUBJECT=mailto:developer@example.test
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=replace-with-ci-sentry-auth-token
CRON_SECRET=replace-with-local-cron-secret
GUARD_SESSION_SECRET=replace-with-local-guard-session-secret-at-least-32-characters
RATE_LIMIT_HASH_SALT=replace-with-local-rate-limit-hash-salt-at-least-32-characters