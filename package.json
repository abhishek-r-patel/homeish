{
  "name": "homeish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:testdb": "node scripts/with-env.mjs testdb next dev",
    "env": "node scripts/with-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" next.config.ts vitest.config.ts vitest.integration.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" next.config.ts vitest.config.ts vitest.integration.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs tsconfig.json .prettierrc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-integration-local.ps1",
    "integrity:check": "node scripts/integrity-check.mjs",
    "integrity:check:testdb": "node scripts/with-env.mjs testdb node scripts/integrity-check.mjs",
    "backup:drive:check": "node scripts/backup-google-drive.mjs check",
    "backup:drive:database": "node scripts/backup-google-drive.mjs upload-database",
    "backup:drive:download": "node scripts/backup-google-drive.mjs download-database",
    "backup:drive:decrypt": "node scripts/backup-google-drive.mjs decrypt-database",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check:headers": "node scripts/check-source-headers.mjs",
    "check:public-env": "node scripts/check-public-env.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:privileged": "node scripts/check-privileged-imports.mjs",
    "db:new": "node scripts/db.mjs new",
    "db:list": "node scripts/with-env.mjs testdb node scripts/db.mjs list",
    "db:push": "node scripts/with-env.mjs testdb node scripts/db.mjs push",
    "db:types": "node scripts/with-env.mjs testdb node scripts/db.mjs types",
    "db:types:check": "node scripts/with-env.mjs testdb node scripts/db.mjs types --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:headers && npm run check:public-env && npm run check:migrations && npm run check:privileged"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.55.0",
    "@tailwindcss/postcss": "^4.3.5",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
