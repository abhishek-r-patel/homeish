# Backup tooling only; copy to .env.backup.local, which must never be committed.
# Do not put these in Vercel, NEXT_PUBLIC_ variables, or application env profiles.
GOOGLE_DRIVE_CLIENT_ID=replace-with-your-own-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-your-own-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-your-own-offline-refresh-token
GOOGLE_DRIVE_FOLDER_ID=replace-with-app-created-private-folder-id
# Generate 32 random bytes, encode as 64 hex characters, and keep an offline recovery copy.
BACKUP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
