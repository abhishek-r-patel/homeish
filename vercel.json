{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "beta": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/jobs/daily",
      "schedule": "30 18 * * *"
    }
  ],
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
